
# FINAL RELEASE — Lume 5.0
# Server
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://domain-anda.com

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lume-media

# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=false

# Lume membership
MEMBER_PRICE_IDR=99000
MAX_MEDIA_BYTES=262144000

# Admin security
# Generate with the command shown in README.
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=

# Redis production session store (required for multi-instance production)
REDIS_URL=rediss://default:PASSWORD@HOST:6379
PG_POOL_MAX=10
TRUST_PROXY=1

# Payment notification verification
# Use only after confirming the notification mode configured for your Midtrans merchant account.
MIDTRANS_NOTIFICATION_MODE=legacy

LOG_LEVEL=info
HEALTHCHECK_PATH=/readyz

# Reliability jobs (15 minutes)
LUME_INTEGRITY_INTERVAL_MS=900000

# V4.5 security event hashing — use a random secret in production
ADMIN_AUDIT_HASH_SALT=
